# X API Read/Public Data
APP_BEARER_TOKEN=
BEARER_TOKEN=

# X API User Context: ใช้กับ Action จริง เช่น Post / Like / Follow / DM / Media
USER_ACCESS_TOKEN=
X_REFRESH_TOKEN=
SELF_USER_ID=
MY_USERNAME=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SEND_TELEGRAM=0

# X API
X_API_BASE_URL=https://api.x.com/2

# Brand settings
BRAND_NAME=ร้านเรา
BRAND_WORDS=

# Cost / query defaults
WOEID=23424960
MAX_POSTS=10
BLOCK_WORDS=เครดิตฟรี, เว็บตรง, แตกง่าย, ฝากถอน, สมัคร, แอดไลน์, โบนัส, โปรโมชั่น, แจกฟรี, คาสิโน, บาคาร่า, เว็บพนัน
REQUIRE_WORDS=
REMOVE_BLOCKED=1

# X Ads API OAuth 1.0a
ADS_CONSUMER_KEY=
ADS_CONSUMER_SECRET=
ADS_ACCESS_TOKEN=
ADS_ACCESS_TOKEN_SECRET=
ADS_ACCOUNT_ID=
ADS_API_BASE_URL=https://ads-api.x.com/12

# OAuth 2.0 User Token helper
X_CLIENT_ID=
X_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://127.0.0.1:8765/callback
OAUTH_SCOPES=tweet.read users.read tweet.write like.write follows.read follows.write list.read list.write dm.read dm.write media.write offline.access
TOKEN_EXPIRES_AT=
